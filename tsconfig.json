/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@tamam/core": ["./libs/core/public-api.ts"],
      "@tamam/shared": ["./libs/shared/public-api.ts"],
      "@tamam/landing": ["./libs/feature/landing/public-api.ts"],
      "@tamam/auth": ["./libs/feature/auth/public-api.ts"],
      "@tamam/dashboard": ["./libs/feature/dashboard/public-api.ts"],
      "@tamam/orders": ["./libs/feature/orders/public-api.ts"],
      "@tamam/customers": ["./libs/feature/customers/public-api.ts"],
      "@tamam/carriers": ["./libs/feature/carriers/public-api.ts"],
      "@tamam/products": ["./libs/feature/products/public-api.ts"],
      "@tamam/billing": ["./libs/feature/billing/public-api.ts"],
      "@tamam/notifications": ["./libs/feature/notifications/public-api.ts"],
      "@tamam/merchant": ["./libs/feature/merchant/public-api.ts"],
      "@tamam/admin": ["./libs/feature/admin/public-api.ts"],
      "@tamam/public-links": ["./libs/feature/public-links/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
